<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KAONOMI.UI</RootNamespace>
    <AssemblyName>KAONOMI.Chat</AssemblyName>
    <ApplicationIcon>Assets/kaonomi-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- The 3D animations call OpenGL through function pointers (Avatar/Gl.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The models, view models and services of the chat are those of KAONOMI.ChatGodot, shared as they are (linked
       sources, namespaces KAONOMI.Chat.*): a change there is a change here. Shared/Views/SceneShaders.cs holds the GLSL
       of the 3D animations, drawn here with OpenGL (Avatar/). ChatViewShims gives the few view types the view models use. -->
  <!-- _old/: the former KAONOMI.Chat (its own models, services, view models and XAML views), kept aside, not built. -->
  <ItemGroup>
    <Compile Remove="_old\**" />
    <AvaloniaXaml Remove="_old\**" />
    <AvaloniaResource Remove="_old\**" />
    <None Remove="_old\**" />
    <AvaloniaResource Include="Assets\kaonomi-logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\KAONOMI.ChatGodot\Shared\**\*.cs" Exclude="..\KAONOMI.ChatGodot\Shared\**\._*" LinkBase="Shared" />
    <Compile Include="..\KAONOMI.ChatGodot\Scripts\Shims\ChatViewShims.cs" Link="Shared\Shims\ChatViewShims.cs" />
  </ItemGroup>

  <!-- The configuration (config.yml, config.json) and the bank of the 1000 questions of /iq, the same files as the Godot chat. -->
  <ItemGroup>
    <None Include="..\KAONOMI.ChatGodot\config.yml" Link="config.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KAONOMI.ChatGodot\config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KAONOMI.ChatGodot\Data\iq-questions.json" Link="Data\iq-questions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KAONOMI.ChatGodot\Assets\Audio\*" LinkBase="Assets\Audio" CopyToOutputDirectory="PreserveNewest" />
    <!-- The images of the 3D faces (Avatar/Avatar3D.cs), the same as the Godot chat. -->
    <None Include="..\KAONOMI.ChatGodot\Assets\*-face.png;..\KAONOMI.ChatGodot\Assets\hal-eye.png" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KAONOMI.ChatGodot\Assets\ghost-city.jpg" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KAONOMI.ChatGodot\Shaders\*.gdshader" LinkBase="Shaders" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\KAONOMI.ChatGodot\Assets\infra\*" Exclude="..\KAONOMI.ChatGodot\Assets\infra\*.import" LinkBase="Assets\infra" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- dotnet build -p:OnlyTools=Data compiles the tool views of Tools/Data only (with the ringer of the alarms, always
       there): a folder of views is checked alone while the others are being written. -->
  <ItemGroup Condition="'$(OnlyTools)' != ''">
    <Compile Remove="Tools\**\*.cs" />
    <Compile Include="Tools\Alarms\*.cs" />
    <Compile Include="Tools\$(OnlyTools)\**\*.cs" Exclude="Tools\Alarms\*.cs" />
    <!-- The journal, the wiki and the chapters of /write use the editor of /work. -->
    <Compile Include="Tools\Work\**\*.cs" Condition="'$(OnlyTools)' == 'Writing'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="TextMateSharp" Version="2.0.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Markdig" Version="0.40.0" />
  </ItemGroup>
</Project>
