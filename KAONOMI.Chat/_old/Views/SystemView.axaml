<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KAONOMI.Chat.ViewModels"
        xmlns:v="using:KAONOMI.Chat.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="950"
        x:Class="KAONOMI.Chat.Views.SystemView"
        x:DataType="vm:SystemWindowViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBlock.model">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="3,8,3,2" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="8">

        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="3,0,3,4">
            <TextBlock Text="System activity" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <v:AddNoteButton Grid.Column="1" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- Row 1: CPU, memory · row 2: GPU, VRAM · row 3: network, as wide as both columns -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">

                    <!-- CPU -->
                    <Border Classes="card" Grid.Row="0" Grid.Column="0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="CPU" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding CpuUsage}" />
                            </Grid>
                            <TextBlock Classes="model" Text="{Binding CpuName}" ToolTip.Tip="{Binding CpuName}" />
                            <v:UsageChart Height="56" LineColor="#2B9BF4" Values="{Binding CpuHistory}"
                                          Capacity="{x:Static vm:SystemWindowViewModel.HistoryLength}" />
                            <TextBlock Classes="meta" Text="{Binding CpuDetails}" />
                        </StackPanel>
                    </Border>

                    <!-- GPU -->
                    <Border Classes="card" Grid.Row="1" Grid.Column="0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="GPU" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding GpuUsage}" />
                            </Grid>
                            <TextBlock Classes="model" Text="{Binding GpuName}" ToolTip.Tip="{Binding GpuName}" />
                            <v:UsageChart Height="56" LineColor="#3DBB4A" Values="{Binding GpuHistory}"
                                          Capacity="{x:Static vm:SystemWindowViewModel.HistoryLength}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="meta" Text="{Binding GpuDetails}" />
                                <!-- GPU temperature (NVIDIA cards, through the driver's NVML) -->
                                <TextBlock Grid.Column="1" Text="{Binding GpuTemperature}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding GpuTemperatureBrush}" Margin="8,4,0,0"
                                           ToolTip.Tip="{Binding GpuTemperatureTip}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GPU memory -->
                    <Border Classes="card" Grid.Row="1" Grid.Column="1">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="VRAM" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding VramUsage}" />
                            </Grid>
                            <TextBlock Classes="model" Text="{Binding VramName}" ToolTip.Tip="{Binding VramName}" />
                            <v:UsageChart Height="56" LineColor="#E3A21A" Values="{Binding VramHistory}"
                                          Capacity="{x:Static vm:SystemWindowViewModel.HistoryLength}" />
                            <TextBlock Classes="meta" Text="{Binding VramDetails}" />
                        </StackPanel>
                    </Border>

                    <!-- Memory -->
                    <Border Classes="card" Grid.Row="0" Grid.Column="1">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="Memory" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding MemoryUsage}" />
                            </Grid>
                            <TextBlock Classes="model" Text="Physical memory (RAM)" />
                            <v:UsageChart Height="56" LineColor="#B65FD1" Values="{Binding MemoryHistory}"
                                          Capacity="{x:Static vm:SystemWindowViewModel.HistoryLength}" />
                            <TextBlock Classes="meta" Text="{Binding MemoryDetails}" />
                        </StackPanel>
                    </Border>

                    <!-- Network -->
                    <Border Classes="card" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="Network" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding NetworkUsage}" />
                            </Grid>
                            <TextBlock Classes="model" Text="{Binding NetworkName}" ToolTip.Tip="{Binding NetworkName}" />
                            <!-- Dynamic scale: the top is the highest received / sent throughput of the last minute -->
                            <Grid ColumnDefinitions="*,Auto">
                                <v:UsageChart Height="56" LineColor="#1FB5A8" SecondaryLineColor="#F28C38"
                                              Values="{Binding NetworkReceivedHistory}"
                                              SecondaryValues="{Binding NetworkSentHistory}"
                                              Maximum="{Binding NetworkScaleMax}"
                                              Capacity="{x:Static vm:SystemWindowViewModel.HistoryLength}" />
                                <DockPanel Grid.Column="1" Margin="6,0,0,0" Height="56">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding NetworkMaxLabel}" FontSize="10" Opacity="0.8" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding NetworkMinLabel}" FontSize="10" Opacity="0.8" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="↓ in" FontSize="10" Foreground="#1FB5A8" />
                                        <TextBlock Text="↑ out" FontSize="10" Foreground="#F28C38" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                            <TextBlock Classes="meta" Text="{Binding NetworkDetails}" ToolTip.Tip="{Binding NetworkDetails}" />
                        </StackPanel>
                    </Border>

                    <!-- GPU temperature (0–100 °C), as wide as both columns -->
                    <Border Classes="card" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardTitle" Text="GPU temperature" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="value" Text="{Binding GpuTemperatureValue}"
                                           Foreground="{Binding GpuTemperatureBrush}" />
                            </Grid>
                            <TextBlock Classes="model" Text="{Binding GpuTemperatureName}" ToolTip.Tip="{Binding GpuTemperatureTip}" />
                            <v:UsageChart Height="56" LineColor="#E8603C" Values="{Binding GpuTemperatureHistory}"
                                          Capacity="{x:Static vm:SystemWindowViewModel.HistoryLength}" />
                            <TextBlock Classes="meta" Text="{Binding GpuTemperatureDetails}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Drives -->
                <TextBlock Classes="section" Text="Drives" />
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DriveItemViewModel">
                            <Border Classes="card" Padding="8,5">
                                <Grid ColumnDefinitions="130,*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Details}" FontSize="10" Opacity="0.7" />
                                    <ProgressBar Grid.Column="1" Grid.RowSpan="2" Minimum="0" Maximum="100" Height="10" MinWidth="40"
                                                 Value="{Binding UsedPercent}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Grid.RowSpan="2" Text="{Binding Capacity}" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Status}" FontSize="11" Opacity="0.7" Margin="3,4,3,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
