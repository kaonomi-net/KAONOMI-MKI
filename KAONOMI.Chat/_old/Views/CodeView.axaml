<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KAONOMI.Chat.ViewModels"
        xmlns:v="using:KAONOMI.Chat.Views"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="KAONOMI.Chat.Views.CodeView"
        x:DataType="vm:CodeWindowViewModel">

    <Design.DataContext>
        <vm:CodeWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.75"
                           Text="{Binding SelectedSnippet.Details, FallbackValue=''}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontSize="12" Text="{Binding Status}" />
                <Button Grid.Column="2" Content="Copy" MinWidth="90" Margin="0,0,6,0"
                        ToolTip.Tip="Copy all the code to the clipboard"
                        Click="OnCopyClick" />
                <Button Grid.Column="3" Content="Save as…" Classes="accent" MinWidth="130"
                        Click="OnSaveAsClick" />
                <v:AddNoteButton Grid.Column="4" Margin="6,0,0,0" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Padding="0"
                    ItemsSource="{Binding Snippets}"
                    SelectedItem="{Binding SelectedSnippet}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodeSnippetViewModel">
                    <TextBlock Text="{Binding Header}" FontSize="14" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:CodeSnippetViewModel">
                    <ScrollViewer Padding="12" HorizontalScrollBarVisibility="Auto">
                        <md:MarkdownRenderer
                            MarkdownBuilder="{Binding Markdown, Converter={x:Static md:ValueConverters.ToObservableStringBuilder}}" />
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</UserControl>
