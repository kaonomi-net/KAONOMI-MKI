<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KAONOMI.Chat.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="KAONOMI.Chat.Views.TaskEditorWindow"
        x:DataType="vm:TaskEditorViewModel"
        Icon="/Assets/kaonomi-logo.ico"
        Width="560" Height="760" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="Kaonomi · Task">

    <Design.DataContext>
        <vm:TaskEditorViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <StackPanel Spacing="2">
            <TextBlock Text="Edit task" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Origin}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Classes="label" Text="Title *" />
                <TextBox x:Name="NameBox" Text="{Binding Name}" />
                <Grid ColumnDefinitions="*,10,*">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Type" />
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="Status" />
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding TaskStatus}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="label" Text="Description" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
                <Grid ColumnDefinitions="*,10,*">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Start" />
                        <CalendarDatePicker SelectedDate="{Binding Start}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="label" Text="End" />
                        <CalendarDatePicker SelectedDate="{Binding End}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="label" Text="Security constraints" />
                <TextBox Text="{Binding Security}" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="Legal constraints" />
                <TextBox Text="{Binding Legal}" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="Data constraints" />
                <TextBox Text="{Binding Data}" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBlock Classes="label" Text="Comment" />
                <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
            <TextBlock Grid.ColumnSpan="3" Classes="status" Classes.error="{Binding IsError}" Text="{Binding Status}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <Button Grid.Row="1" Content="Delete" MinWidth="90" Command="{Binding DeleteCommand}"
                    ToolTip.Tip="Marks the task deleted (isDeleted = true): it leaves the board, nothing is erased" />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" MinWidth="90" Command="{Binding CancelCommand}" />
                <Button Content="Save" Classes="accent" MinWidth="110" Command="{Binding SaveCommand}"
                        ToolTip.Tip="Saves the task (Ctrl+S) and reloads the board" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
