<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KAONOMI.Chat.ViewModels"
             xmlns:v="using:KAONOMI.Chat.Views"
             xmlns:s="using:KAONOMI.Chat.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="850"
             x:Class="KAONOMI.Chat.Views.MusicPlayerView"
             x:DataType="vm:MusicPlayerViewModel">

    <Design.DataContext>
        <vm:MusicPlayerViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.folder">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Transport buttons: round, flat -->
        <Style Selector="Button.transport">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.transport.main">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="60" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ListBox#TrackList > ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: path, search, folder, refresh -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Music" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="↑" Padding="10,2" Command="{Binding UpCommand}" ToolTip.Tip="Parent folder" />
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:PictureFolder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="›" Opacity="0.5" VerticalAlignment="Center" Margin="2,0" />
                                    <Button Classes="crumb" Content="{Binding Name}" ToolTip.Tip="{Binding Path}"
                                            Command="{Binding $parent[v:MusicPlayerView].((vm:MusicPlayerViewModel)DataContext).OpenFolderCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Open folder" Command="{Binding OpenFolderInSystemCommand}"
                            ToolTip.Tip="Open this folder in the Finder / Explorer" />
                    <Button Content="⟳" Padding="10,4" Command="{Binding RefreshCommand}" ToolTip.Tip="Read the folder again (F5)" />
                    <v:AddNoteButton />
                </StackPanel>
                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="{Binding SearchText}"
                         PlaceholderText="Filter the tracks of this folder by name…" />
            </Grid>
        </Border>

        <!-- Body: folders and tracks on the left, now playing on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,380">
            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="12,10,6,6">
                <ScrollViewer Grid.Row="0" MaxHeight="150" IsVisible="{Binding HasFolders}">
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:PictureFolder">
                                <Button Classes="folder" ToolTip.Tip="{Binding Path}"
                                        Command="{Binding $parent[v:MusicPlayerView].((vm:MusicPlayerViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Panel Grid.Row="1">
                    <ListBox x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MusicTrackViewModel">
                                <Grid ColumnDefinitions="40,*,60,80">
                                    <Panel>
                                        <TextBlock Text="{Binding Number}" Classes="meta" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsCurrent}" />
                                        <TextBlock Text="♪" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                                   IsVisible="{Binding IsCurrent}" />
                                    </Panel>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"
                                               FontWeight="{Binding IsCurrent, Converter={x:Static v:MusicPlayerView.CurrentWeight}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Format}" Classes="meta" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Classes="meta" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No track here" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsEmpty}" IsHitTestVisible="False" />
                </Panel>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <!-- Now playing -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Margin="18,16" Spacing="10">
                    <Border Width="300" Height="300" CornerRadius="14" ClipToBounds="True" HorizontalAlignment="Center"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <Panel>
                            <TextBlock Text="♫" FontSize="96" Opacity="0.25" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasArtwork}" />
                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Panel>
                    </Border>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Position (drag to seek) -->
                    <StackPanel>
                        <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}"
                                IsEnabled="{Binding HasTrack}" ToolTip.Tip="Drag to move in the track" />
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Classes="meta" Text="{Binding PositionLabel}" />
                            <TextBlock Grid.Column="1" Classes="meta" Text="{Binding DurationLabel}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Transport -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <Button Classes="transport" Content="🔀" Opacity="{Binding ShuffleOpacity}" Command="{Binding ToggleShuffleCommand}"
                                ToolTip.Tip="Shuffle" />
                        <Button Classes="transport" Content="⏮" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous track (back to the start after 3 s)" />
                        <Button Classes="transport main" Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}"
                                ToolTip.Tip="Play / pause (Space)" />
                        <Button Classes="transport" Content="⏭" Command="{Binding NextCommand}" ToolTip.Tip="Next track" />
                        <Button Classes="transport" Content="{Binding RepeatLabel}" Opacity="{Binding RepeatOpacity}"
                                Command="{Binding ToggleRepeatCommand}" ToolTip.Tip="Repeat: all, one, off" />
                    </StackPanel>
                    <Button Content="⏹ Stop" HorizontalAlignment="Center" Padding="14,4" Command="{Binding StopCommand}" />

                    <!-- Volume and level -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                        <TextBlock Text="🔈" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume}" Margin="8,0"
                                ToolTip.Tip="Volume" />
                        <TextBlock Grid.Column="2" Text="🔊" VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Level}" Height="4"
                                 ToolTip.Tip="Loudness of the track" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Padding="12,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#E81123" IsVisible="{Binding IsError}" />
                <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding RootDirectory, StringFormat='· music: {0}'}" FontSize="12" Opacity="0.55"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
