<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KAONOMI.Chat.ViewModels"
             xmlns:v="using:KAONOMI.Chat.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="860"
             x:Class="KAONOMI.Chat.Views.ProjectView"
             x:DataType="vm:ProjectWindowViewModel">

    <Design.DataContext>
        <vm:ProjectWindowViewModel />
    </Design.DataContext>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewTaskCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Border.column">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>
        <Style Selector="Border.column.drop">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="#E5484D" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Padding="12,8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="Project · tasks" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+ New task" Classes="accent" MinWidth="110" Margin="0,0,8,0"
                        Command="{Binding NewTaskCommand}" ToolTip.Tip="Creates a task (Ctrl+N)" />
                <Button Grid.Column="2" Content="Refresh" MinWidth="100" Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Loads the tasks again (F5)" />
            </Grid>
        </Border>

        <!-- One column per status -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
        <ItemsControl x:Name="Board" ItemsSource="{Binding Columns}" Margin="7,12" DragDrop.AllowDrop="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KanbanColumnViewModel">
                    <Border Classes="column" Classes.drop="{Binding IsDropTarget}" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Height="4" Background="{Binding Accent}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="12,10,12,8">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,1" Background="{Binding Accent}">
                                    <TextBlock Text="{Binding Count}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <ScrollViewer Grid.Row="2" Padding="10,0,10,4">
                                <Panel>
                                    <TextBlock Text="No task" Opacity="0.45" FontSize="12" HorizontalAlignment="Center"
                                               Margin="0,12" IsVisible="{Binding IsEmpty}" />
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:KanbanCardViewModel">
                                                <Border Classes="card" ToolTip.Tip="{Binding Description}" Cursor="SizeAll"
                                                        DoubleTapped="OnCardDoubleTapped">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <Border Classes="badge" Background="{Binding TypeBrush}">
                                                            <TextBlock Text="{Binding Type}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Panel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Form of a new task -->
        <Border Grid.Column="1" Width="380" Margin="0,12,12,12" Padding="14" CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" IsVisible="{Binding IsCreating}">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Text="New task" FontSize="15" FontWeight="SemiBold" />
                <ScrollViewer Grid.Row="1" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Title *" />
                        <TextBox x:Name="NameBox" Text="{Binding NewName}" PlaceholderText="What has to be done" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="Type" />
                                <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="Status" />
                                <ComboBox ItemsSource="{Binding NewStatuses}" SelectedItem="{Binding NewTaskStatus}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="label" Text="Description" />
                        <TextBox Text="{Binding NewDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel>
                                <TextBlock Classes="label" Text="Start" />
                                <CalendarDatePicker SelectedDate="{Binding NewStart}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="End" />
                                <CalendarDatePicker SelectedDate="{Binding NewEnd}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Classes="label" Text="Security constraints" />
                        <TextBox Text="{Binding NewSecurity}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Classes="label" Text="Legal constraints" />
                        <TextBox Text="{Binding NewLegal}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Classes="label" Text="Data constraints" />
                        <TextBox Text="{Binding NewData}" AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Classes="label" Text="Comment" />
                        <TextBox Text="{Binding NewComment}" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" Command="{Binding CancelNewCommand}" />
                    <Button Content="Create" Classes="accent" MinWidth="110" Command="{Binding SaveNewCommand}"
                            ToolTip.Tip="Saves the task (PUT /task) and reloads the board" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="2" Padding="12,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="status" Classes.error="{Binding IsError}" Text="{Binding Status}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <v:AddNoteButton Grid.Column="1" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
