<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KAONOMI.Chat.Views.ConfirmDialog"
        Icon="/Assets/kaonomi-logo.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Kaonomi · Confirm">

    <StackPanel Margin="20" Spacing="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" />
            <Button x:Name="ConfirmButton" Content="Delete" MinWidth="90" Classes="accent" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
