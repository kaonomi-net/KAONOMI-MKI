<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KAONOMI.Chat.ViewModels"
             xmlns:v="using:KAONOMI.Chat.Views"
             xmlns:m="using:KAONOMI.Chat.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="KAONOMI.Chat.Views.ConfigView"
             x:DataType="vm:ConfigWindowViewModel">
    <UserControl.Styles>
        <!-- The editor is a transparent TextBox over the colored copy of its text: its border never paints a background -->
        <Style Selector="TextBox#Editor /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox#Editor:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox#Editor:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.status.error">
            <Setter Property="Foreground" Value="#E81123" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header: file, Presets (voice and animation, applied at once), SAVE, RELOAD -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="config.yml" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FilePath}" FontSize="11" Opacity="0.6" Margin="12,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          PlaceholderText="Presets" MinWidth="130" Margin="0,0,8,0" VerticalAlignment="Center"
                          ToolTip.Tip="Voice and animation preset: written into config.yml, saved and applied at once">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:ChatPreset">
                            <StackPanel ToolTip.Tip="{Binding Description}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="3" Content="SAVE" Classes="accent" MinWidth="80" Margin="0,0,6,0"
                        ToolTip.Tip="Saves config.yml (the previous version is kept as config-YYYYMMDD.config)"
                        Command="{Binding SaveCommand}" />
                <Button Grid.Column="4" Content="RELOAD" MinWidth="80"
                        ToolTip.Tip="Reads config.yml again (the changes not saved are dropped)"
                        Command="{Binding ReloadCommand}" />
                <v:AddNoteButton Grid.Column="5" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Editor: the colored text below, the TextBox (transparent text, visible caret and selection) on top -->
        <ScrollViewer Grid.Row="1" x:Name="EditorScroller" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid>
                <SelectableTextBlock x:Name="Highlight" Margin="10,8" IsHitTestVisible="False"
                                     FontFamily="Cascadia Mono, Menlo, Consolas, monospace" FontSize="13"
                                     TextWrapping="NoWrap" />
                <TextBox x:Name="Editor" Text="{Binding Text}" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" Padding="10,8" MinHeight="0" BorderThickness="0"
                         FontFamily="Cascadia Mono, Menlo, Consolas, monospace" FontSize="13"
                         Background="Transparent" Foreground="Transparent" SelectionForegroundBrush="Transparent"
                         CaretBrush="{DynamicResource SystemControlForegroundBaseHighBrush}"
                         SelectionBrush="#552EB7D7" />
            </Grid>
        </ScrollViewer>

        <!-- Status: loaded / saved / error, and the modified mark -->
        <Border Grid.Row="2" Padding="12,4"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="● modified" FontSize="12" Foreground="#B18D1D" IsVisible="{Binding IsModified}" />
                <TextBlock Classes="status" Classes.error="{Binding IsError}" Text="{Binding Status}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
