<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local MARI packages (produced by "dotnet pack" of the MARI solution) until they are published on nuget.org.
         Relative to this file, so that it works on Windows, macOS, Linux and in the Docker builds: see mari-nupkgs/README.md
         (on Windows, mari-nupkgs can be a junction to the shared feed N:\mari-nupkgs\1.0.0). -->
    <add key="mari-local" value="mari-nupkgs" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="mari-local">
      <package pattern="MARI.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
